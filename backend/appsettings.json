{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [
      "http://localhost:5173"
    ]
  },
  "JwtSettings": {
    "SecretKey": "<JWT_SECRET_KEY_PLACEHOLDER>",
    "Issuer": "<JWT_ISSUER_PLACEHOLDER>",
    "ExpiryMinutes": 60
  },
  "LockoutSettings": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "PasswordResetSettings": {
    "TokenExpiryMinutes": 10
  },
  "ConnectionStrings": {
    "DefaultConnection": "<POSTGRES_CONNECTION_STRING_PLACEHOLDER>"
  },
  "SmtpSettings": {
    "Host": "<SMTP_HOST_PLACEHOLDER>",
    "Port": 587,
    "User": "<SMTP_USER_PLACEHOLDER>",
    "Password": "<SMTP_PASSWORD_PLACEHOLDER>"
  },
  "AuditLogging": {
    "Provider": "database",
    "Immutable": true
  }
}